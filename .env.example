AGENT_NAME=HomeOps
SQLITE_PATH=./agent.db

ROUTER_BASE_URL=http://127.0.0.1:8080
ROUTER_CHAT_PATH=/v1/chat/completions
ROUTER_API_KEY=
ROUTER_MODEL=openrouter/auto
REQUEST_TIMEOUT_SECONDS=60

CONTEXT_MESSAGES=12
MAX_TOOL_LOOPS=4

WHATSAPP_SEND_URL=http://127.0.0.1:3000/sendMessage
WHATSAPP_TOKEN=
WHATSAPP_DEFAULT_CHAT_ID=
WEBHOOK_SECRET=

HOME_ASSISTANT_BASE_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

PAPERLESS_BASE_URL=http://paperless.local:8000
PAPERLESS_TOKEN=

WATCH_ENTITY_IDS=["sensor.washer_state","binary_sensor.front_door"]
WATCHER_INTERVAL_SECONDS=300
PAPERLESS_POLL_SECONDS=600
HEARTBEAT_INTERVAL_SECONDS=1800

LOG_LEVEL=INFO
