[Unit]
Description=Pi Agent Harness
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sethjacobs
WorkingDirectory=/Users/sethjacobs/Development/pi-agent-harness
EnvironmentFile=/Users/sethjacobs/Development/pi-agent-harness/.env
ExecStart=/Users/sethjacobs/Development/pi-agent-harness/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8787
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
